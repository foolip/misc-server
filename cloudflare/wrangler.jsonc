// Wrangler configuration for the whatwg-sites Worker. Use the wrangler version
// in package.json (npm ci, then npm run deploy).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whatwg-sites",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",

  // Production. Hosts are added here one at a time during cutover, as
  // Custom Domains, for example:
  //   { "pattern": "dom.spec.whatwg.org", "custom_domain": true }
  // See README.md. Removing an entry and deploying is the rollback.
  "workers_dev": false,
  "routes": [],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "whatwg-sites" }
  ],
  "observability": { "enabled": true }
}
