{
  "private": true,
  "type": "module",
  "scripts": {
    "convert": "node tools/nginx-to-json.mjs && node tools/lock-rules.mjs",
    "check-config": "node tools/nginx-to-json.mjs --check && node tools/lock-rules.mjs --check",
    "test": "node --test \"test/**/*.test.mjs\"",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --infer-origin-from-routes=false",
    "local:seed": "node tools/try-local.mjs seed",
    "local:compare": "node tools/try-local.mjs compare",
    "lock-rules": "node tools/lock-rules.mjs",
    "lock-rules:apply": "wrangler r2 bucket lock set whatwg-sites --file config/lock-rules.json"
  },
  "devDependencies": {
    "wrangler": "4.156.2"
  }
}
